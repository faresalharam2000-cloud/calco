function viewDebts(v){
  var d = branchData();
  var customers = d.contacts.filter(function(c){ return c.type === 'customer'; }).map(function(c){ return { c:c, s:contactStats(c) }; }).filter(function(x){ return x.s.balance !== 0; });
  var suppliers = d.contacts.filter(function(c){ return c.type === 'supplier'; }).map(function(c){ return { c:c, s:contactStats(c) }; }).filter(function(x){ return x.s.balance !== 0; });
  var cTotal = customers.reduce(function(a,x){ return a + Math.max(0, x.s.balance); }, 0);
  var sTotal = suppliers.reduce(function(a,x){ return a + Math.max(0, x.s.balance); }, 0);

  function tbl(list, label){
    if(!list.length) return '<p class="muted">لا توجد ديون على '+label+'.</p>';
    return '<div class="tbl-wrap"><table class="tbl"><thead><tr><th>الاسم</th><th class="num">إجمالي التعامل</th><th class="num">المدفوع</th><th class="num">المتبقي</th></tr></thead><tbody>' +
      list.map(function(x){
        return '<tr><td>'+esc(x.c.name)+'</td><td class="num">'+money(x.s.total)+'</td>' +
          '<td class="num">'+money(x.s.paid)+'</td>' +
          '<td class="num" style="font-weight:900;color:'+(x.s.balance>0?'var(--warn)':'var(--ok)')+'">'+money(x.s.balance)+'</td></tr>';
      }).join('') + '</tbody></table></div>';
  }

  v.innerHTML =
    '<div class="grid cards">' +
      stat('إجمالي ديون العملاء', money(cTotal), 'warn') +
      stat('إجمالي ديون الموردين', money(sTotal), 'warn') +
      stat('صافي المديونية', money(cTotal - sTotal), 'primary') +
    '</div>' +
    '<div class="card"><h3>ديون العملاء (لنا)</h3>'+tbl(customers, 'العملاء')+'</div>' +
    '<div class="card"><h3>ديون الموردين (علينا)</h3>'+tbl(suppliers, 'الموردين')+'</div>';
}

function viewContacts(v){
  var d = branchData();
  var rows = d.contacts;
  var rowsHtml;
  if(rows.length){
    rowsHtml = '<div class="tbl-wrap"><table class="tbl"><thead><tr><th>الاسم</th><th>النوع</th><th>الهاتف</th><th class="num">الرصيد</th><th></th></tr></thead><tbody>' +
      rows.map(function(c){
        var s = contactStats(c);
        return '<tr><td>'+esc(c.name)+'</td>' +
          '<td><span class="badge '+(c.type==='customer'?'blue':'purple')+'">'+(c.type==='customer'?'عميل':'مورد')+'</span></td>' +
          '<td>'+esc(c.phone || '—')+'</td>' +
          '<td class="num" style="color:'+(s.balance>0?'var(--warn)':'var(--ok)')+'">'+money(s.balance)+'</td>' +
          '<td><button class="btn danger sm" data-del="contacts" data-id="'+c.id+'">حذف</button></td></tr>';
      }).join('') + '</tbody></table></div>';
  } else {
    rowsHtml = '<p class="muted">لا يوجد عملاء أو موردون بعد.</p>';
  }

  v.innerHTML =
    '<div class="card"><h3>إضافة عميل / مورد</h3>' +
      '<form id="f-contact" class="form-grid">' +
        '<label>النوع<select id="c-type"><option value="customer">عميل</option><option value="supplier">مورد</option></select></label>' +
        '<label>الاسم<input id="c-name" required></label>' +
        '<label>الهاتف<input id="c-phone" placeholder="اختياري"></label>' +
        '<div><button class="btn primary" type="submit">إضافة</button></div>' +
      '</form>' +
    '</div>' +
    '<div class="card"><h3>القائمة ('+rows.length+')</h3>' + rowsHtml + '</div>';

  $('#f-contact').onsubmit = function(e){
    e.preventDefault();
    var name = $('#c-name').value.trim();
    if(!name) return toast('أدخل الاسم', 'err');
    db.contacts.push({
      id: uid(), companyId: session.companyId, branchId: session.branchId,
      type: $('#c-type').value, name: name, phone: $('#c-phone').value.trim()
    });
    saveDB(); toast('تمت الإضافة'); viewContacts(v);
  };

  bindDeletes(v);
}

function viewReports(v){
  var period = ui.reportPeriod;
  var rows = buildReport(period, ui.reportFrom, ui.reportTo);
  var t = rows.reduce(function(a,r){
    return { sales:a.sales+r.sales, purchases:a.purchases+r.purchases, expenses:a.expenses+r.expenses,
             cashIn:a.cashIn+r.cashIn, cashOut:a.cashOut+r.cashOut };
  }, { sales:0, purchases:0, expenses:0, cashIn:0, cashOut:0 });

  var rowsHtml;
  if(rows.length){
    rowsHtml = '<div class="tbl-wrap"><table class="tbl"><thead><tr>' +
      '<th>الفترة</th><th class="num">المبيعات</th><th class="num">المشتريات</th>' +
      '<th class="num">المصروفات</th><th class="num">المقبوضات</th><th class="num">المدفوعات</th><th class="num">صافي النقد</th>' +
      '</tr></thead><tbody>' +
      rows.map(function(r){
        var net = r.cashIn - r.cashOut;
        return '<tr><td>'+groupLabel(r.key, period)+'</td>' +
          '<td class="num">'+money(r.sales)+'</td><td class="num">'+money(r.purchases)+'</td>' +
          '<td class="num">'+money(r.expenses)+'</td><td class="num">'+money(r.cashIn)+'</td>' +
          '<td class="num">'+money(r.cashOut)+'</td>' +
          '<td class="num" style="font-weight:900;color:'+(net>=0?'var(--ok)':'var(--danger)')+'">'+money(net)+'</td></tr>';
      }).join('') +
      '</tbody><tfoot><tr><td>الإجمالي</td>' +
        '<td class="num">'+money(t.sales)+'</td><td class="num">'+money(t.purchases)+'</td>' +
        '<td class="num">'+money(t.expenses)+'</td><td class="num">'+money(t.cashIn)+'</td>' +
        '<td class="num">'+money(t.cashOut)+'</td><td class="num">'+money(t.cashIn - t.cashOut)+'</td></tr></tfoot></table></div>';
  } else {
    rowsHtml = '<p class="muted">لا توجد بيانات في هذه الفترة.</p>';
  }

  v.innerHTML =
    '<div class="card"><h3>التقارير الدورية</h3>' +
      '<div class="form-grid">' +
        '<label>نوع التقرير<select id="r-period">' +
          '<option value="day" '+(period==='day'?'selected':'')+'>يومي</option>' +
          '<option value="week" '+(period==='week'?'selected':'')+'>أسبوعي</option>' +
          '<option value="month" '+(period==='month'?'selected':'')+'>شهري</option>' +
        '</select></label>' +
        '<label>من تاريخ<input type="date" id="r-from" value="'+(ui.reportFrom||'')+'"></label>' +
        '<label>إلى تاريخ<input type="date" id="r-to" value="'+(ui.reportTo||'')+'"></label>' +
        '<div class="row" style="gap:8px">' +
          '<button class="btn primary" id="r-apply">تحديث</button>' +
          '<button class="btn" id="r-print">طباعة</button>' +
        '</div>' +
      '</div>' +
    '</div>' +
    '<div class="grid cards">' +
      stat('المبيعات', money(t.sales)) +
      stat('المشتريات', money(t.purchases)) +
      stat('المصروفات', money(t.expenses)) +
      stat('المقبوضات النقدية', money(t.cashIn), 'ok') +
      stat('المدفوعات النقدية', money(t.cashOut), 'warn') +
      stat('صافي الحركة النقدية', money(t.cashIn - t.cashOut), 'primary') +
    '</div>' +
    '<div class="card"><h3>تفصيل الفترات</h3>' + rowsHtml + '</div>';

  $('#r-apply').onclick = function(){
    ui.reportPeriod = $('#r-period').value;
    ui.reportFrom = $('#r-from').value;
    ui.reportTo = $('#r-to').value;
    viewReports(v);
  };
  $('#r-print').onclick = function(){ window.print(); };
}

function bindDeletes(v){
  v.querySelectorAll('[data-del]').forEach(function(btn){
    btn.onclick = function(){
      if(!confirm('تأكيد الحذف؟')) return;
      var col = btn.dataset.del, id = btn.dataset.id;
      db[col] = db[col].filter(function(x){ return x.id !== id; });
      saveDB(); toast('تم الحذف'); renderView();
    };
  });
}

render();

} catch(err) {
  showError((err && err.stack) || (err && err.message) || String(err));
}

})();
</script>
</body>
</html>
